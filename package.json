{
  "name": "tracerace",
  "version": "0.4.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.18",
    "@better-auth/expo": "1.7.18",
    "@expo/vector-icons": "^15.0.2",
    "@hono/node-server": "^2.1.6",
    "@neon/config": "^1.12.0",
    "@neon/functions": "^0.11.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "better-auth": "1.7.18",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "drizzle-orm": "^0.45.4",
    "expo": "~57.0.32",
    "expo-constants": "~57.0.23",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-network": "~57.0.3",
    "expo-router": "~57.0.30",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "hono": "^4.13.16",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify:c": "node --import tsx scripts/verify-c.ts",
    "build:web": "node --import tsx scripts/build-public.ts && expo export --platform web",
    "check": "npm run format:check && npm run typecheck && npm test && npm run verify:c && npm run lint && npm run build:web",
    "format": "prettier --write src server server-tests tests scripts docs neon.ts drizzle.config.ts README.md app.json package.json tsconfig.json eslint.config.js .github/workflows/check.yml .prettierrc.json",
    "format:check": "prettier --check src server server-tests tests scripts docs neon.ts drizzle.config.ts README.md app.json package.json tsconfig.json eslint.config.js .github/workflows/check.yml .prettierrc.json",
    "api": "node --env-file-if-exists=.env.local --import tsx server/local.ts",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate --config drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate --config drizzle.config.ts",
    "test:api": "node --env-file-if-exists=.env.local --import tsx --test server-tests/*.test.ts",
    "smoke:api": "node --env-file-if-exists=.env.local --import tsx scripts/smoke-api.ts",
    "smoke:accounts": "node --env-file-if-exists=.env.local --import tsx scripts/smoke-accounts.ts",
    "build:web:release": "node --import tsx scripts/build-public.ts && node scripts/build-web-release.mjs",
    "serve:web": "node --import tsx server/web.ts"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "minimatch": "^11.0.5",
    "glob": "^14.0.4",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
